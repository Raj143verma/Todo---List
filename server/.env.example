# App Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database & Authentication
MONGODB_URI=mongodb://localhost:27017/todo-saas
JWT_SECRET=your_super_secret_jwt_signing_key
JWT_EXPIRES_IN=7d

# AI Features (Google Gemini)
GOOGLE_GEMINI_API_KEY=your_gemini_api_key_here
ENABLE_AI_FEATURES=true
AI_RATE_LIMIT=10

# ===============================================================================
# EMAIL NOTIFICATIONS SYSTEM CONFIGURATION
# ===============================================================================

# Choose your provider: "gmail", "sendgrid", or "smtp" (for Mailtrap/others)
EMAIL_SERVICE=gmail

# Sender Display Details
EMAIL_FROM_NAME=Todo SaaS
EMAIL_FROM_ADDRESS=noreply@todosaas.com

# ----------------- Option 1: Gmail Setup (Development) -----------------
# Generate a 16-character App Password from Google Account Security.
# Do NOT use your main Google account password.
EMAIL_USER=rajvermause@gmail.com
EMAIL_PASSWORD=rksmxtxciqivrzwn

# ----------------- Option 2: SendGrid Setup (Production) ---------------
# Use your SendGrid API Key starting with 'SG.'
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxx

# ----------------- Option 3: Custom SMTP (e.g., Mailtrap, Mailgun) -----
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_SECURE=false
